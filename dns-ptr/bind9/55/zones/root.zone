$TTL 86400
. IN SOA  ns1.root. admin.root. (
    2026032401  ; SERIAL
    3600        ; REFRESH
    900         ; RETRY
    604800      ; EXPIRE
    86400       ; NXDOMAIN TTL
)

.  IN NS ns1.root.
ns1.root. IN A 172.20.0.55

; 委派 arpa. 到顶级域DNS服务器
arpa.    IN  NS  ns1.arpa.
ns1.arpa.   IN A   172.20.0.57
